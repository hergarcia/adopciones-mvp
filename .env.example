# Copiá este archivo a .env.local y completalo con `supabase status -o env`.
# .env.local está ignorado por git; este ejemplo no lleva ningún valor real.

# URL de la instancia local de Supabase.
NEXT_PUBLIC_SUPABASE_URL=

# Clave anónima. Viaja al browser a propósito: es la que usa la app sin sesión.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio. Saltea RLS, así que NUNCA lleva el prefijo NEXT_PUBLIC_ y nunca se versiona:
# cualquier variable con ese prefijo la manda al browser. Hay una compuerta que falla si aparece
# expuesta o versionada (scripts/check-service-key.mjs).
SUPABASE_SERVICE_ROLE_KEY=

# Opcional. La URL pública de la app; por defecto http://localhost:3000.
NEXT_PUBLIC_APP_URL=
