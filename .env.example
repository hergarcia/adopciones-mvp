# Copiá este archivo a .env.local y completalo con `supabase status -o env`.
# .env.local está ignorado por git; este ejemplo no lleva ningún valor real.

# URL de la instancia local de Supabase.
NEXT_PUBLIC_SUPABASE_URL=

# Clave anónima. Viaja al browser a propósito: es la que usa la app sin sesión.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio. Saltea RLS, así que NUNCA lleva el prefijo NEXT_PUBLIC_ y nunca se versiona:
# cualquier variable con ese prefijo la manda al browser. Hay una compuerta que falla si aparece
# expuesta o versionada (scripts/check-service-key.mjs).
SUPABASE_SERVICE_ROLE_KEY=

# Opcional. La URL pública de la app; por defecto http://localhost:3000.
NEXT_PUBLIC_APP_URL=

# --- Historia #9: registro e ingreso. Ninguna de estas es obligatoria. ---

# Clave de Resend, para que el correo del enlace salga de verdad. Sin ella, el mismo mensaje se
# escribe en .artifacts/mail/ y de ahí lo lee la prueba de punta a punta (KL-006). El envío real
# necesita además un dominio verificado, que no existe hasta que se decida el nombre (docs/04).
RESEND_API_KEY=

# Remitente del correo del enlace. Por defecto, onboarding@resend.dev, el dominio compartido de
# pruebas de Resend: solo entrega a la dirección de la cuenta de Resend, cualquier otro
# destinatario lo rechaza (KL-006). Con el dominio propio verificado, acá va una dirección de ese
# dominio y deja de haber límite.
RESEND_FROM=

# Credenciales del cliente OAuth de Google. Sin ellas, "Entrar con Google" no se muestra y el
# ingreso por correo funciona igual (FR-011). Se sacan de Google Cloud → Credenciales → ID de
# cliente OAuth, con http://127.0.0.1:54321/auth/v1/callback como URI de redirección autorizada.
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
