{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "nextjs", "jsx-a11y", "import", "vitest"],
  "jsPlugins": ["./tools/oxlint-rules/index.mjs"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css"]
      }
    ],
    "vitest/expect-expect": "error",
    "vitest/no-disabled-tests": "error",
    "vitest/no-conditional-expect": "error",
    "max-lines": [
      "warn",
      {
        "max": 150,
        "skipBlankLines": true,
        "skipComments": true
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/src/components/**", "**/src/app/**"],
      "rules": {
        "react/jsx-no-literals": "error",
        "adopciones/no-hex-color-in-component": "error",
        "adopciones/no-literal-visible-text": "error"
      }
    },
    {
      "files": ["**/src/**"],
      "excludeFiles": ["**/src/lib/supabase/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/lib/supabase/client",
                  "@/lib/supabase/server",
                  "**/supabase/client",
                  "**/supabase/server",
                  "@supabase/*"
                ],
                "message": "Nadie llama a la base fuera de lib/supabase/: ni por el cliente del proyecto ni importando el SDK directo (CLAUDE.md §Convenciones)."
              },
              {
                "group": ["../**", "!../../messages/**"],
                "message": "Importá con el alias @/: las reglas de capas y de acceso a datos leen el alias, y un ../ las saltea."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/src/components/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/lib/supabase/**", "@supabase/*"],
                "message": "Un componente no hace fetch ni llama a la base, tampoco por una query: recibe el objeto por props (docs/08 §Tres capas)."
              },
              {
                "group": ["@/app/**"],
                "message": "Las dependencias van app → dominio → ui, solo hacia abajo (docs/08 §Tres capas)."
              },
              {
                "group": ["../**", "!../../messages/**"],
                "message": "Importá con el alias @/: las reglas de capas y de acceso a datos leen el alias, y un ../ las saltea."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/src/components/ui/**"],
      "rules": {
        "react/jsx-no-literals": "off",
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/components/**", "!@/components/ui", "!@/components/ui/**"],
                "message": "Una primitiva ui/ no conoce el dominio: recibe todo traducido por props (docs/08 §Tres capas)."
              },
              {
                "group": ["@/lib/supabase/**", "@supabase/*"],
                "message": "Una primitiva ui/ no sabe de datos (docs/08 §Tres capas)."
              },
              {
                "group": ["@/app/**"],
                "message": "Las dependencias van app → dominio → ui, solo hacia abajo (docs/08 §Tres capas)."
              },
              {
                "group": ["../**", "!../../messages/**"],
                "message": "Importá con el alias @/: las reglas de capas y de acceso a datos leen el alias, y un ../ las saltea."
              }
            ]
          }
        ],
        "adopciones/no-literal-visible-text": "off"
      }
    },
    {
      "files": ["**/page.tsx", "**/layout.tsx"],
      "rules": {
        "adopciones/no-use-client-in-route-entry": "error"
      }
    },
    {
      "files": ["**/page.tsx"],
      "rules": {
        "adopciones/require-route-metadata": "error"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/*.test.mjs", "**/tests/**"],
      "rules": {
        "max-lines": "off"
      }
    },
    {
      "files": ["**/scripts/**"],
      "rules": {
        "typescript/require-array-sort-compare": "off",
        "no-await-in-loop": "off"
      }
    },
    {
      "files": ["**/tests/setup/**"],
      "rules": {
        "vitest/valid-title": "off",
        "vitest/expect-expect": "off"
      }
    }
  ],
  "ignorePatterns": ["src/lib/supabase/types.ts"]
}
