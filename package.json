{
  "name": "adopciones-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "next dev",
    "lint": "prettier --check . && node scripts/check-service-key.mjs && renovate-config-validator && oxlint --type-aware src scripts tools tests --ignore-pattern \"tests/gates/fixtures/**\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "mutation": "node scripts/mutation.mjs",
    "mutation:all": "node scripts/mutation.mjs --all",
    "build": "next build",
    "start": "next start",
    "e2e": "playwright test --pass-with-no-tests",
    "lighthouse": "lhci autorun",
    "verify": "node scripts/verify.mjs",
    "db:types": "node scripts/db-types.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-toast": "1.2.23",
    "@supabase/supabase-js": "2.116.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "next": "16.3.5",
    "next-intl": "4.14.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "lefthook": "2.1.14",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2002",
    "prettier": "3.9.8",
    "renovate": "44.103.0",
    "supabase": "2.117.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
