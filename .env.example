# Copiá este archivo a .env.local y completalo con `supabase status -o env`.
# .env.local está ignorado por git; este ejemplo no lleva ningún valor real.

# URL de la instancia local de Supabase.
NEXT_PUBLIC_SUPABASE_URL=

# Clave publicable (`sb_publishable_…`). Viaja al browser a propósito: es la que usa la app sin sesión.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave secreta (`sb_secret_…`). Saltea RLS, así que NUNCA lleva el prefijo NEXT_PUBLIC_ y nunca se versiona:
# cualquier variable con ese prefijo la manda al browser. Hay una compuerta que falla si aparece
# expuesta o versionada (scripts/check-service-key.mjs).
SUPABASE_SECRET_KEY=

# Opcional. La URL pública de la app; por defecto http://localhost:3000.
NEXT_PUBLIC_APP_URL=

# --- Historia #9: registro e ingreso. Ninguna de estas es obligatoria. ---

# Clave de Resend, para que el correo del enlace salga de verdad. Sin ella, el mismo mensaje se
# escribe en .artifacts/mail/ y de ahí lo lee la prueba de punta a punta (KL-006). El envío real
# necesita además un dominio verificado, que no existe hasta que se decida el nombre (docs/04).
RESEND_API_KEY=

# Remitente del correo del enlace. Por defecto, onboarding@resend.dev, el dominio compartido de
# pruebas de Resend: solo entrega a la dirección de la cuenta de Resend, cualquier otro
# destinatario lo rechaza (KL-006). Con el dominio propio verificado, acá va una dirección de ese
# dominio y deja de haber límite.
RESEND_FROM=

# Interruptor de "Entrar con Google": con `true` el botón se muestra; sin él, no, y el ingreso por
# correo funciona igual (FR-011). La app no lee el cliente ni el secreto de Google: viven en
# Supabase. En local, `supabase start` los resuelve desde un `.env` en la raíz (ignorado por git, no
# lee .env.local, que es de Next) con SUPABASE_AUTH_GOOGLE_CLIENT_ID y SUPABASE_AUTH_GOOGLE_SECRET,
# sacados de Google Cloud → Credenciales → ID de cliente OAuth, con
# http://127.0.0.1:54321/auth/v1/callback como URI de redirección autorizada.
GOOGLE_SIGN_IN_ENABLED=

# --- Historia #10: verificación de teléfono. Ninguna es obligatoria. ---

# Twilio, para que el código salga por mensaje de texto de verdad. Van las tres o ninguna: con
# alguna suelta, el mensaje no sale. Sin ellas y contra la base local, el mismo mensaje se escribe
# en .artifacts/sms/ y de ahí lo lee la prueba de punta a punta; contra cualquier otra base, el
# pedido falla (FR-009c). Se sacan de la consola de Twilio: Account SID y Auth Token en la portada
# de la cuenta, y el SID de un Messaging Service (MG…) con un remitente habilitado para Uruguay.
#
# Los resúmenes del código y del número se derivan de SUPABASE_SECRET_KEY: rotarla invalida
# los códigos vivos (vencen igual en 10 minutos) y resetea los conteos de 24 horas.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# Opcional. La dirección de ayuda que ven quien llega al tope de intentos de la verificación de
# identidad y el correo de un rechazo por sospecha de fraude. Sin ella, una reservada que no llega a
# nadie; hasta que exista el dominio, va la dirección del equipo.
NEXT_PUBLIC_SUPPORT_EMAIL=

# --- Historia #11: verificación de identidad. ---

# El secreto con el que la base llama a /api/cron/identidad para mandar los correos de vencimiento.
# Este valor es el de desarrollo y es el mismo que el seed guarda en Vault (`cron_secret`): en
# local funciona con solo copiarlo. En la nube va otro, en el entorno y en Vault. Sin él, la ruta
# rechaza todo.
CRON_SECRET=desarrollo-local

# --- Historia #71: encuesta, opiniones y WhatsApp de soporte. ---

# Opcional. El WhatsApp de soporte, con el código de país y sin el más (598…). Sin él, el pie y
# Opinar no nombran ningún WhatsApp.
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# --- Historia #169 y #356: el sitio de verdad, en el servidor de casa. Solo en el entorno de la app
# en Dokploy (docs/puesta-en-marcha.md); en local no van.

# `production` en el servidor. Con ella, el contenedor empuja las migraciones al arrancar y PostHog y
# Sentry reciben lo que les toca; sin ella, como en local, en CI y en las pruebas, no sale nada.
DEPLOY_ENV=

# La cadena de la base del servidor por la red de Dokploy, con `sslmode=disable` (adentro no hay
# TLS). Con ella y `DEPLOY_ENV=production`, el contenedor empuja las migraciones antes de atender
# (scripts/deploy/migrate.mjs); sin ella, no arranca. En local las aplica `supabase db reset`.
SUPABASE_DB_URL=

# La clave del proyecto de PostHog (US Cloud). Con ella y `DEPLOY_ENV`, cada momento de la medición
# sale desde el servidor; sin ella, o en local, se escribe al registro del servidor y no sale nada.
POSTHOG_PROJECT_KEY=

# El DSN del proyecto de Sentry (región US). Con él y `DEPLOY_ENV`, cada falla sale al registro de
# errores sin datos de la persona; sin él, o en local, va solo al registro del servidor.
SENTRY_DSN=
